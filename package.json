{
  "name": "poc-automation-js-playwright",
  "version": "1.0.0",
  "description": "POC de automação QA com Playwright - UI + API",
  "scripts": {
    "test": "playwright test",
    "test:ui": "playwright test tests/ui",
    "test:api": "playwright test tests/api",
    "test:sanity": "playwright test --grep @sanity",
    "test:critical": "playwright test --grep @critical",
    "test:regression": "playwright test --grep @regression",
    "report:playwright": "playwright show-report reports/playwright-report",
    "report:allure:generate": "allure generate reports/allure-results -o reports/allure-report --clean",
    "report:allure:open": "allure open reports/allure-report",
    "lint": "eslint tests/"
  },
  "devDependencies": {
    "@playwright/test": "^1.44.0",
    "allure-playwright": "^3.0.0",
    "dotenv": "^16.4.5",
    "eslint": "^9.0.0",
    "eslint-plugin-playwright": "^1.6.0"
  }
}
